# Synapse Services Configuration
# Copy to services.yaml and customize
#
# Format:
#   services:
#     - name:
#         repo: repository URL (required)
#         path: local path (optional, defaults to services/name)
#         env: environment variables (optional)

services:
  # Synapse server - AI inference gateway (LLM, MCP, STT, TTS)
  - synapse-server:
      repo: git@github.com:omnidotdev/synapse-server#master
  # Synapse dashboard - billing and usage management UI
  - synapse-dashboard:
      repo: git@github.com:omnidotdev/synapse-dashboard#master
  # Synapse API - GraphQL API for dashboard and platform integration
  - synapse-api:
      repo: git@github.com:omnidotdev/synapse-api#master
