# Synapse Stack Environment
# Copy to .env.local and fill in required values

# --- Required (generate secrets with: `openssl rand -base64 32`) ---
DB_PASSWORD=changeme
AUTH_SECRET=changeme
GATEWAY_SECRET=changeme
ENCRYPTION_KEY=changeme
# AUTH_BASE_URL=            # URL of HIDRA Gatekeeper instance (optional, enables SSO)

# --- Database ---
# DB_NAME=synapse
# DB_USER=postgres
# DB_PORT=5432

# --- Valkey (distributed rate limiting + response cache) ---
# VALKEY_URL=redis://localhost:6379
# VALKEY_PORT=6379

# --- API ---
# API_PORT=4000
# NODE_ENV=production
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# PROTECT_ROUTES=true
# AUTH_WEBHOOK_SECRET=

# --- Gateway ---
# GATEWAY_PORT=6000

# Provider API keys (at least one LLM provider required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# NVIDIA_API_KEY=
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=
# BRAVE_API_KEY=

# --- App ---
# APP_PORT=3000
# VITE_BASE_URL=http://localhost:3000
# VITE_API_BASE_URL=http://localhost:4000

# Auth (optional, for external OIDC provider)
# VITE_AUTH_BASE_URL=
# AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=

# --- Billing (optional) ---
# BILLING_URL=
# BILLING_BASE_URL=
# BILLING_SERVICE_API_KEY=
# BILLING_WEBHOOK_SECRET=
# VITE_BILLING_BASE_URL=

# --- Authorization (optional) ---
# AUTHZ_API_URL=
# AUTHZ_ENABLED=
# VITE_AUTHZ_API_URL=
# VITE_AUTHZ_ENABLED=
