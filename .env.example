# Synapse Stack Environment
# Copy to .env and fill in required values

# --- Database ---
DB_NAME=synapse
DB_USER=postgres
DB_PASSWORD=          # required
DB_PORT=5432

# --- API ---
AUTH_SECRET=          # required, generate with: openssl rand -hex 32
GATEWAY_SECRET=       # required, generate with: openssl rand -hex 32
ENCRYPTION_KEY=       # required, generate with: openssl rand -base64 32
API_PORT=4000
NODE_ENV=production
CORS_ALLOWED_ORIGINS=http://localhost:3000
PROTECT_ROUTES=true
AUTH_BASE_URL=          # required, URL of HIDRA Gatekeeper instance
AUTH_WEBHOOK_SECRET=    # HMAC secret for IDP webhook verification

# --- Gateway ---
GATEWAY_PORT=6000

# Provider API keys (at least one LLM provider required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
NVIDIA_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
BRAVE_API_KEY=

# --- App ---
APP_PORT=3000
VITE_BASE_URL=http://localhost:3000
VITE_API_BASE_URL=http://api:4000

# Auth (optional, for external OIDC provider)
VITE_AUTH_BASE_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# --- Billing / Aether (optional) ---
AETHER_URL=
AETHER_SERVICE_API_KEY=
BILLING_BASE_URL=
BILLING_SERVICE_API_KEY=
BILLING_WEBHOOK_SECRET=
VITE_BILLING_BASE_URL=

# --- Authorization (optional) ---
AUTHZ_API_URL=
AUTHZ_ENABLED=
VITE_AUTHZ_API_URL=
VITE_AUTHZ_ENABLED=
